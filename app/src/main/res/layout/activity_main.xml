<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />

    <Button
        android:id="@+id/request_permission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/request_permission" />

    <!-- 十字キー状に矢印を配置: ↓=0° (通常), ←=90°, ↑=180°, →=270° -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="3"
        android:rowCount="3">

        <Space android:layout_row="0" android:layout_column="0" />
        <ImageButton
            android:id="@+id/rotate_180"
            style="@style/ArrowButton"
            android:layout_row="0"
            android:layout_column="1"
            android:contentDescription="@string/cd_rot_180"
            android:src="@drawable/ic_arrow_0" />
        <Space android:layout_row="0" android:layout_column="2" />

        <ImageButton
            android:id="@+id/rotate_90"
            style="@style/ArrowButton"
            android:layout_row="1"
            android:layout_column="0"
            android:contentDescription="@string/cd_rot_90"
            android:src="@drawable/ic_arrow_270" />
        <Space
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_row="1"
            android:layout_column="1" />
        <ImageButton
            android:id="@+id/rotate_270"
            style="@style/ArrowButton"
            android:layout_row="1"
            android:layout_column="2"
            android:contentDescription="@string/cd_rot_270"
            android:src="@drawable/ic_arrow_90" />

        <Space android:layout_row="2" android:layout_column="0" />
        <ImageButton
            android:id="@+id/rotate_0"
            style="@style/ArrowButton"
            android:layout_row="2"
            android:layout_column="1"
            android:contentDescription="@string/cd_rot_0"
            android:src="@drawable/ic_arrow_180" />
        <Space android:layout_row="2" android:layout_column="2" />
    </GridLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/hint"
        android:textSize="13sp" />
</LinearLayout>
